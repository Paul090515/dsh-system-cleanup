  "version": "2.0.1",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "check": "bash scripts/check.sh",
    "package:zip": "bash scripts/package.sh"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Paul090515/dsh-system-cleanup.git"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "skill",
    "cleanup",
    "cache",
    "cleaner",
    "maintenance",
    "system"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "references",
    "agents",
    "tests",
